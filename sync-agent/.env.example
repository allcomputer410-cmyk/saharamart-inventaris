# ════════════════════════════════════════════════════════
# SYNC AGENT CONFIG — SAHARAMART
# Salin file ini menjadi .env, lalu isi semua nilai
# ════════════════════════════════════════════════════════

# ── Supabase Cloud ──────────────────────────────────────
# Ambil SERVICE_KEY dari: Supabase Dashboard → Project Settings → API
# Pilih key "service_role" (BUKAN anon key)
SUPABASE_URL=https://gtxumvwadbqtbxoowhge.supabase.co
SUPABASE_SERVICE_KEY=ISI_SERVICE_ROLE_KEY_DARI_SUPABASE_DASHBOARD

# ── iPOS PostgreSQL 8.4 (di PC kasir) ──────────────────
# ✅ Database dan kode kantor sudah dikonfirmasi dari iPOS Saharamart
IPOS_DB_HOST=localhost
IPOS_DB_PORT=5432
IPOS_DB_NAME=SAHARAMART
IPOS_DB_USER=postgres
# Password: coba kosong dulu, kalau gagal tanya ke teknisi/installer iPOS
IPOS_DB_PASS=

# ── Sync Settings ──────────────────────────────────────
# Interval sync dalam menit (default: 15)
SYNC_INTERVAL=15

# Level log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
