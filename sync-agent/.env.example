# ════════════════════════════════════════════════════════
# SYNC AGENT CONFIG — SAHARAMART
# Salin file ini menjadi .env, lalu isi semua nilai
# ════════════════════════════════════════════════════════

# ── Backend Inventaris ─────────────────────────────────
# URL server aplikasi inventaris, diakhiri /api/sync
# Token dibuat di server dengan: npm run backend:sync-key -- ID_TOKO
# Token hanya berlaku untuk satu toko.
INVENTORY_API_URL=https://DOMAIN-SERVER-ANDA/api/sync
INVENTORY_SYNC_TOKEN=ISI_TOKEN_SYNC_TOKO

# ── iPOS PostgreSQL 8.4 (di PC kasir) ──────────────────
IPOS_DB_HOST=localhost
IPOS_DB_PORT=5444
IPOS_DB_NAME=i4_SAHARAMART
IPOS_DB_USER=admin
IPOS_DB_PASS=

# ── Filter Toko ────────────────────────────────────────
STORE_CODE=SM01

# ── Sync Settings ──────────────────────────────────────
# Interval sync dalam menit (default: 15)
SYNC_INTERVAL=15

# Level log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
