# Salin jadi deploy/.env, atau jalankan deploy/setup.sh untuk mengisi 3 secret acak.
# JANGAN commit file .env yang sudah terisi.

# --- diisi otomatis oleh setup.sh (secret acak 64 hex) ---
POSTGRES_PASSWORD=
REST_DB_PASSWORD=
POSTGREST_JWT_SECRET=

# --- WAJIB diisi manual ---
# Domain HTTPS publik aplikasi (harus sama dengan yang di Caddy).
APP_ORIGIN=https://inventaris.deliveryku.com

# --- opsional ---
# Port lokal VPS tempat app di-bind (Caddy proxy ke sini). Ganti jika 3100 dipakai.
APP_PORT=3100
# Hanya perlu kalau mengaktifkan cron analisis promo otomatis.
CRON_SECRET=
